package-as: GoldPilot

manual-changelog:
  filename: docs/RELEASE_NOTES.md
  markup-type: markdown

# El empaquetado real no se ha probado.
move-folders:
  GoldPilot/GoldPilot: GoldPilot

ignore:
  - docs
  - tools
  - .agents
  - .claude
  - .agentrelay
  - .github
  - CLAUDE.md
  - AGENTS.md
  - TODO.md
  - VERSION
  - README.en.md
  - .luacheckrc
  - .gitignore
  - GoldPilotDev.toc
  - GoldPilot/Data/Local
  - tests
  - .pkgmeta
